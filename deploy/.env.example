# Copy to /opt/tracker/.env on the VPS (chmod 600). Never commit the real file.
# Spec section 13 has the full reference; see deploy/README.md.

# --- api (required) ---
BASE_URL=https://omni.tail2b3fbf.ts.net

# --- api (optional, defaults shown) ---
#MAX_ATTACHMENT_BYTES=10485760
#MAX_MCP_UPLOAD_BYTES=5242880
#DEFAULT_ISSUE_KEY=MAT
#ALLOW_AGENT_PURGE=false
#RATE_LIMIT_PER_MIN=120
#LOG_LEVEL=info
#TRUST_PROXY=true
# Extra ports (besides 443) that MCP sourceUrl fetches may use, comma-separated.
#SOURCE_URL_EXTRA_PORTS=

# --- web ---
# Token of a `you` actor, created with the traccia CLI. Server-side only.
TRACCIA_API_TOKEN=
# Comma-separated Tailscale logins allowed to open the dashboard.
DASHBOARD_ALLOWED_LOGINS=

# Existing installs from before the Traccia rename: keep their data volume (see deploy/README.md).
#TRACCIA_DATA_VOLUME=tracker_tracker-data
