  {
    "name": "save_issue",
    "description": "Create (no id; needs title + project) or update (with id; only provided fields change). `labels`, `blockedBy`, `blocks` REPLACE the whole set. `project` on update moves the issue (identifier unchanged; parent/milestone reset). Labels must exist (list_issue_labels / save_issue_label). Pass expectedUpdatedAt to fail on concurrent edits. Returns the compact issue.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Issue identifier. Omit to create.",
          "type": "string"
        },
        "title": {
          "description": "Required on create.",
          "type": "string"
        },
        "project": {
          "description": "Project key, name, or id. Required on create; on update, moves the issue.",
          "type": "string"
        },
        "description": {
          "description": "Markdown. Replaces the whole description.",
          "type": "string"
        },
        "status": {
          "description": "One of: Backlog, Todo, In Progress, In Review, Done, Canceled (case-insensitive; also backlog|todo|in_progress|in_review|done|canceled). Default on create: Backlog.",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string"
            }
          ],
          "description": "0/none, 1/urgent, 2/high, 3/medium, 4/low (same as Linear)."
        },
        "estimate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee": {
          "description": "null unassigns.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent",
                "you"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "description": "Replaces the label set. Names must already exist.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone": {
          "description": "Milestone name or id in the issue's project; null clears.",
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "description": "Makes this a sub-issue; null detaches. Same project only.",
          "type": [
            "string",
            "null"
          ]
        },
        "blockedBy": {
          "description": "Replaces the set of issues blocking this one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "description": "Replaces the set of issues this one blocks.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedUpdatedAt": {
          "description": "Fail if the issue changed since this updatedAt (update only).",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
  {
    "name": "save_issue_label",
    "description": "Create a label (omit id; name required; no project = global) or update name/color (with id). Names are unique per scope, case-insensitive.",
