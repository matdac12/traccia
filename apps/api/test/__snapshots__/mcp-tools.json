[
  {
    "name": "create_attachment",
    "description": "Attach a file (e.g. a screenshot) to an issue or comment. Give exactly one of contentBase64 (max ~5 MB decoded) or sourceUrl (public HTTPS, downloaded by the server). Returns a markdown snippet to paste.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1,
          "description": "Issue identifier or id."
        },
        "commentId": {
          "description": "Attach to this comment.",
          "type": "string"
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "mimeType": {
          "description": "Inferred if omitted.",
          "type": "string"
        },
        "contentBase64": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string"
        }
      },
      "required": [
        "issueId",
        "filename"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_attachment",
    "description": "Soft-delete an attachment (restorable). purge=true permanently removes an already-deleted item; only actor 'you' (agents need ALLOW_AGENT_PURGE).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Attachment id."
        },
        "purge": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_comment",
    "description": "Soft-delete a comment and its replies (restorable via restore). purge=true permanently removes an already-deleted item; only actor 'you' (agents need ALLOW_AGENT_PURGE).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Comment id."
        },
        "purge": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_issue",
    "description": "Soft-delete an issue with its sub-issues, comments and attachments (restorable via restore). purge=true permanently removes an already-deleted item; only actor 'you' (agents need ALLOW_AGENT_PURGE).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Issue identifier."
        },
        "purge": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_milestone",
    "description": "Soft-delete a milestone; its issues are kept with milestone cleared (restorable via restore). purge=true permanently removes an already-deleted item; only actor 'you' (agents need ALLOW_AGENT_PURGE).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Milestone id."
        },
        "purge": {
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "delete_project",
    "description": "Soft-delete a project (hides its milestones and issues; restorable via restore). purge=true permanently removes an already-deleted item; only actor 'you' (agents need ALLOW_AGENT_PURGE).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "Project key, name or id."
        },
        "purge": {
          "type": "boolean"
        }
      },
      "required": [
        "project"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_attachment",
    "description": "Get an attachment's metadata; images under 2 MB are also returned inline unless includeContent is false.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Attachment id."
        },
        "includeContent": {
          "default": true,
          "type": "boolean"
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_issue",
    "description": "Get one issue with its full markdown description. `include` defaults to comments, attachments, children, relations; add 'activity' for the change log.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Issue identifier (ABC-123)."
        },
        "include": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "comments",
              "attachments",
              "activity",
              "children",
              "relations"
            ]
          }
        }
      },
      "required": [
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "get_project",
    "description": "Get a project with its description and milestones (with progress).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string",
          "description": "Project key, name or id."
        },
        "includeMilestones": {
          "description": "Default true.",
          "type": "boolean"
        }
      },
      "required": [
        "project"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_comments",
    "description": "List an issue's comments oldest first, replies right after their parent (parentId set).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "description": "Issue identifier (ABC-123)."
        },
        "includeDeleted": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "Previous nextCursor.",
          "type": "string"
        }
      },
      "required": [
        "issueId"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_issue_labels",
    "description": "List global labels, plus a project's labels when project is given. There is no delete tool; labels are removed in the dashboard.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "description": "Add this project's labels.",
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "Previous nextCursor.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_issues",
    "description": "List issues, newest update first, as compact items (get_issue for full text). Filters AND together; status values OR; a label array needs ALL labels. Page with nextCursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "Full-text search (titles, descriptions, comments).",
          "type": "string"
        },
        "project": {
          "description": "Project key, name or id.",
          "type": "string"
        },
        "status": {
          "description": "Backlog, Todo, In Progress, In Review, Done or Canceled (case-insensitive; in_progress style ok).",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "assignee": {
          "type": "string",
          "enum": [
            "agent",
            "you",
            "none"
          ]
        },
        "label": {
          "description": "Label name(s); all required.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "milestone": {
          "description": "Milestone name or id.",
          "type": "string"
        },
        "parentId": {
          "description": "Sub-issues of this issue.",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string"
            }
          ],
          "description": "0/none, 1/urgent, 2/high, 3/medium, 4/low."
        },
        "createdBy": {
          "type": "string",
          "enum": [
            "agent",
            "you"
          ]
        },
        "updatedAfter": {
          "description": "ISO 8601 timestamp or duration like -P1D.",
          "type": "string"
        },
        "includeDeleted": {
          "type": "boolean"
        },
        "orderBy": {
          "description": "Default updatedAt.",
          "type": "string",
          "enum": [
            "updatedAt",
            "createdAt",
            "priority",
            "sortOrder",
            "title"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "Previous nextCursor.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_milestones",
    "description": "List milestones (all projects, or one) with progress {done,total}; canceled issues excluded.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "description": "Omit for all projects.",
          "type": "string"
        },
        "includeDeleted": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "Previous nextCursor.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "list_projects",
    "description": "List projects with issue counts per status.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "Match against name/key.",
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "completed",
            "canceled"
          ]
        },
        "includeDeleted": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "Previous nextCursor.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "restore",
    "description": "Undo a soft delete: restores the item and everything deleted with it in the same action. Restoring a milestone does not re-link its issues.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "issue",
            "comment",
            "project",
            "milestone",
            "attachment"
          ]
        },
        "id": {
          "type": "string",
          "description": "Identifier for issues; id for others."
        }
      },
      "required": [
        "type",
        "id"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_comment",
    "description": "Create (no id; needs issueId) or edit (with id; own comments only) a comment. parentId replies to a top-level comment (one level of threading).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "issueId": {
          "type": "string"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "description": "Markdown."
        },
        "parentId": {
          "type": "string"
        }
      },
      "required": [
        "body"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_issue",
    "description": "Create (no id; needs title + project) or update (with id; only given fields change). `labels`, `blockedBy`, `blocks` REPLACE the whole set; labels must exist (save_issue_label). `project` on update moves the issue (identifier kept; parent/milestone reset). expectedUpdatedAt fails on concurrent edits.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "project": {
          "description": "Project key, name or id.",
          "type": "string"
        },
        "description": {
          "description": "Markdown; replaces the whole text.",
          "type": "string"
        },
        "status": {
          "description": "Backlog, Todo, In Progress, In Review, Done or Canceled (case-insensitive; in_progress style ok). Default: Backlog.",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string"
            }
          ],
          "description": "0/none, 1/urgent, 2/high, 3/medium, 4/low."
        },
        "estimate": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "assignee": {
          "description": "null unassigns.",
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "agent",
                "you"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "milestone": {
          "description": "Milestone name or id; null clears.",
          "type": [
            "string",
            "null"
          ]
        },
        "parentId": {
          "description": "Parent issue (same project); null detaches.",
          "type": [
            "string",
            "null"
          ]
        },
        "blockedBy": {
          "description": "Issues blocking this one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocks": {
          "description": "Issues this one blocks.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expectedUpdatedAt": {
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_issue_label",
    "description": "Create a label (omit id; name required; no project = global) or update name/color (with id). Names are unique per scope, case-insensitive.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "description": "Hex #rrggbb.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "project": {
          "description": "Project key, name or id; omit/null = global. Fixed after creation.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_milestone",
    "description": "Create a milestone (omit id; project and name required) or update one (with id). targetDate is YYYY-MM-DD, null clears.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "project": {
          "type": "string",
          "description": "Project key, name or id."
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "targetDate": {
          "description": "YYYY-MM-DD; null clears.",
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "save_project",
    "description": "Create a project (omit id; name required) or update one (with id).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "key": {
          "description": "Issue prefix (default MAT); fixed after creation.",
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]{1,7}$"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "description": "Default: active.",
          "type": "string",
          "enum": [
            "active",
            "paused",
            "completed",
            "canceled"
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    }
  },
  {
    "name": "whoami",
    "description": "The actor ('agent' or 'you') and token name this connection writes as.",
    "inputSchema": {
      "type": "object",
      "properties": {}
    }
  }
]
