          "minLength": 1
        },
        "color": {
          "description": "Hex #rrggbb.",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "project": {
          "description": "Omit/null = global label. Cannot change on update.",
          "anyOf": [
            {
              "type": "string",
              "description": "Project key (e.g. ABC), name, or id."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
