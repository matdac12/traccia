  {
    "name": "create_attachment",
    "description": "Attach a file (typically a screenshot) to an issue or one of its comments. Provide exactly one of contentBase64 (max ~5 MB decoded) or sourceUrl (public HTTPS URL the server downloads). Returns a ready-to-paste markdown snippet.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "issueId": {
          "type": "string",
          "minLength": 1,
          "description": "Issue identifier (MAT-123) or id."
        },
        "commentId": {
          "description": "Attach to a specific comment instead of the issue.",
          "type": "string"
        },
        "filename": {
          "type": "string",
          "minLength": 1,
          "description": "e.g. login-bug.png"
        },
        "mimeType": {
          "description": "Inferred from content if omitted; verified by content sniffing.",
          "type": "string"
        },
        "contentBase64": {
          "description": "Max ~5 MB decoded.",
          "type": "string"
        },
        "sourceUrl": {
          "description": "HTTPS URL the server will download (size-capped).",
          "type": "string"
        }
      },
      "required": [
        "issueId",
        "filename"
      ],
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
