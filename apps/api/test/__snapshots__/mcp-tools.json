  {
    "name": "list_issues",
    "description": "List issues, newest update first. Compact items (description truncated; use get_issue for full text). Filters are AND-ed; `status` values are OR-ed; `label` array requires ALL labels. Deleted issues are hidden unless includeDeleted. Page with nextCursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "description": "Full-text search over titles, descriptions, comments.",
          "type": "string"
        },
        "project": {
          "description": "Project key, name, or id.",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string",
              "description": "One of: Backlog, Todo, In Progress, In Review, Done, Canceled (case-insensitive; also backlog|todo|in_progress|in_review|done|canceled)."
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "description": "One of: Backlog, Todo, In Progress, In Review, Done, Canceled (case-insensitive; also backlog|todo|in_progress|in_review|done|canceled)."
              }
            }
          ]
        },
        "assignee": {
          "type": "string",
          "enum": [
            "agent",
            "you",
            "none"
          ]
        },
        "label": {
          "description": "Label name(s); issues must have all.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "milestone": {
          "description": "Milestone name or id.",
          "type": "string"
        },
        "parentId": {
          "description": "List sub-issues of this issue (identifier).",
          "type": "string"
        },
        "priority": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            {
              "type": "string"
            }
          ],
          "description": "0/none, 1/urgent, 2/high, 3/medium, 4/low (same as Linear)."
        },
        "createdBy": {
          "type": "string",
          "enum": [
            "agent",
            "you"
          ]
        },
        "updatedAfter": {
          "description": "ISO 8601 timestamp or duration like -P1D.",
          "type": "string"
        },
        "includeDeleted": {
          "description": "Include soft-deleted issues.",
          "type": "boolean"
        },
        "orderBy": {
          "description": "Default updatedAt.",
          "type": "string",
          "enum": [
            "updatedAt",
            "createdAt",
            "priority",
            "sortOrder"
          ]
        },
        "limit": {
          "description": "Default 50.",
          "type": "integer",
          "minimum": 1,
          "maximum": 250
        },
        "cursor": {
          "description": "From a previous nextCursor.",
          "type": "string"
        }
      },
      "$schema": "http://json-schema.org/draft-07/schema#"
    },
    "execution": {
      "taskSupport": "forbidden"
    }
  },
