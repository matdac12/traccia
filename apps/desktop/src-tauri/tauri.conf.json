{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Traccia",
  "mainBinaryName": "traccia-desktop",
  "version": "0.1.0",
  "identifier": "app.traccia.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:3170",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Traccia",
        "width": 380,
        "height": 520,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "shadow": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Traccia: your open To-dos, one key away",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}
