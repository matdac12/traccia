#!/bin/sh
# Fast local gate, wired by `pnpm install` (the `prepare` script sets core.hooksPath).
# Lints and format-checks only the files in this commit, so it stays under a second.
set -e

cd "$(git rev-parse --show-toplevel)"

if [ -x node_modules/.bin/biome ]; then
  BIOME=./node_modules/.bin/biome
else
  BIOME="pnpm exec biome"
fi

$BIOME lint --staged --no-errors-on-unmatched
$BIOME format --staged --no-errors-on-unmatched

# Optional: scan the staged diff for secrets when gitleaks is installed (see .gitleaks.toml).
# Not required; install it yourself if you want this guard.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --staged --redact --no-banner
fi
